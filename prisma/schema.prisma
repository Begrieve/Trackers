generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  /** Signs in to the demo's own tables, never the real ledger. */
  isDemo       Boolean  @default(false)
  createdAt    DateTime @default(now())

  orders   Order[]
  payments Payment[]
  batches  Batch[]
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  notes     String?
  createdAt DateTime @default(now())

  orders      Order[]
  payments    Payment[]
  allocations BatchAllocation[]

  @@index([name])
}

model Variety {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  products Product[]
  yields   BatchYield[]
}

model Product {
  id        String   @id @default(cuid())
  name      String
  varietyId String?
  /** How much kimchi this jar holds, in ounces. A 16 oz jar holds about 1 lb. */
  jarWeightOz Int    @default(16)
  unitLabel String   @default("jar")
  unitPrice Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  variety Variety? @relation(fields: [varietyId], references: [id], onDelete: SetNull)

  items       OrderItem[]
  allocations BatchAllocation[]
}

enum OrderStatus {
  PENDING
  DELIVERED
  CANCELLED
}

model Order {
  id          String      @id @default(cuid())
  customerId  String
  status      OrderStatus @default(PENDING)
  orderedAt   DateTime    @default(now())
  dueAt       DateTime?
  deliveredAt DateTime?
  notes       String?
  createdById String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  customer  Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdBy User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items     OrderItem[]
  payments  Payment[]

  @@index([customerId])
  @@index([status])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  batchId   String?
  name      String
  quantity  Int
  unitPrice Int
  /** Snapshot, like the name and price: what this jar was when it was sold. */
  varietyId String?
  jarWeightOz Int   @default(16)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  batch   Batch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([batchId])
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  OTHER
}

model Payment {
  id           String        @id @default(cuid())
  orderId      String
  customerId   String
  amount       Int
  method       PaymentMethod @default(CASH)
  paidAt       DateTime      @default(now())
  note         String?
  recordedById String?
  createdAt    DateTime      @default(now())

  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  recordedBy User?    @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([customerId])
}

model Batch {
  id          String   @id @default(cuid())
  code        String   @unique
  label       String
  madeOn      DateTime @default(now())
  readyOn     DateTime?
  notes       String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy  User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  yields      BatchYield[]
  costs       BatchCost[]
  orderItems  OrderItem[]
  allocations BatchAllocation[]

  @@index([madeOn])
}

model BatchCost {
  id      String @id @default(cuid())
  batchId String
  label   String
  amount  Int

  batch Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
}

/** Where jars went when nobody bought them. */
enum AllocationKind {
  DONATED
  KEPT
  SHIPPED
  WASTED
}

model BatchAllocation {
  id        String         @id @default(cuid())
  batchId   String
  productId String
  name      String
  quantity  Int
  varietyId String?
  jarWeightOz Int          @default(16)
  kind      AllocationKind
  note      String?
  // Who it went to, when there is someone to name. Optional, because a jar
  // kept for the household or one that spoiled went to nobody.
  customerId String?
  // The day it actually left, which is not always the day it was recorded.
  wentOutOn DateTime       @default(now())
  createdAt DateTime       @default(now())

  batch    Batch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  product  Product   @relation(fields: [productId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([batchId])
  @@index([customerId])
}

/** What a batch made: weight of one kimchi type. Jars are filled from it later. */
model BatchYield {
  id        String @id @default(cuid())
  batchId   String
  varietyId String
  name      String
  /** Ounces. Stored as a whole number so repeated arithmetic cannot drift. */
  weightOz  Int

  batch   Batch   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  variety Variety @relation(fields: [varietyId], references: [id])

  @@index([batchId])
}
