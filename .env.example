# Postgres connection string (Neon, Vercel Postgres, Supabase, or your own server)
DATABASE_URL="postgresql://user:password@host:5432/kimchi?sslmode=require"

# Session signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me"

# Accounts created by `npm run db:seed`
SEED_OWNER_EMAIL="you@example.com"
SEED_OWNER_NAME="Your Name"
SEED_OWNER_PASSWORD="choose-a-strong-password"

SEED_PARTNER_EMAIL="wife@example.com"
SEED_PARTNER_NAME="Her Name"
SEED_PARTNER_PASSWORD="choose-a-strong-password"

# Optional demo account. Set these and a demo login appears, reading and
# writing its own separate set of tables — the real ledger is untouched.
SEED_DEMO_EMAIL="demo@example.com"
SEED_DEMO_NAME="Demo"
SEED_DEMO_PASSWORD="choose-a-demo-password"

# Where the demo's tables live. Leave unset to use a "demo" schema on the same
# database (separate tables, nothing to provision). Set it to put the demo on a
# different database entirely.
# DEMO_DATABASE_URL=""

# Needed only when self-hosting outside Vercel, which sets it for you.
# AUTH_TRUST_HOST=true
