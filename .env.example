PORT=3000

# How often (ms) the aggregated feed is cached before re-fetching upstream sources.
CACHE_TTL_MS=60000

# Push notifications (optional — leave unset to disable the feature entirely).
# Generate a keypair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Shared secret an external scheduler must send (as the X-Cron-Secret header)
# to hit POST /api/push/check. Required for that endpoint to work. Generate
# any random string, e.g.: openssl rand -hex 32
CRON_SECRET=
