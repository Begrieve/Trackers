# Postgres connection string (Neon, Vercel Postgres, Supabase, or your own server)
DATABASE_URL="postgresql://user:password@host:5432/kimchi?sslmode=require"

# Session signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me"

# Accounts created by `npm run db:seed`
SEED_OWNER_EMAIL="you@example.com"
SEED_OWNER_NAME="Your Name"
SEED_OWNER_PASSWORD="choose-a-strong-password"

SEED_PARTNER_EMAIL="wife@example.com"
SEED_PARTNER_NAME="Her Name"
SEED_PARTNER_PASSWORD="choose-a-strong-password"
